# System Settings
ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Google Drive Integration & OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/drive/oauth/callback
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_CREDENTIALS_PATH=data/credentials.json
GOOGLE_TOKEN_PATH=data/token.json

# Model Providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional

# Selected Models
DEFAULT_LLM_PROVIDER=gemini  # gemini or openai
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=sentence-transformers # sentence-transformers or gemini or openai
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Vectors
VECTOR_STORE_TYPE=chroma # chroma or inmemory
CHROMA_PERSIST_DIRECTORY=data/chroma_db
DATA_DIR=data
EXTRACTED_IMAGES_DIR=data/extracted_images
METADATA_DB_PATH=data/metadata.db

# Reranking & Retrieval
HYBRID_ALPHA=0.5 # Balance between Vector Search (alpha) and BM25 Search (1 - alpha)
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
USE_RERANKER=true
