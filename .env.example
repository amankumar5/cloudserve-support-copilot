# System Configuration
ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Drive Integration & OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/drive/oauth/callback
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_CREDENTIALS_PATH=data/credentials.json
GOOGLE_TOKEN_PATH=data/token.json

# Model Providers & LLMs
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional
DEFAULT_LLM_PROVIDER=gemini  # gemini or openai
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=sentence-transformers # sentence-transformers or gemini or openai
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage Configuration
VECTOR_STORE_TYPE=supabase # supabase, chroma or inmemory
DATA_DIR=data
EXTRACTED_IMAGES_DIR=data/extracted_images
METADATA_DB_PATH=data/metadata.db

# Reranking & Retrieval
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
USE_RERANKER=true
